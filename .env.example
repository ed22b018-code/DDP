# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your key.  (cp .env.example .env)
# -----------------------------------------------------------------------------
# The Gen-AI recommendation layer uses the Anthropic API. If you leave this
# blank (or don't create a .env file at all), the system STILL WORKS -- it
# just falls back to clear rule-based recommendation text instead of the LLM.
#
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
