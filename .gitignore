# =============================================================================
# .gitignore -- keep secrets and generated/junk files OUT of git.
# =============================================================================

# --- Secrets (NEVER commit) --------------------------------------------------
# (keep .env.example tracked -- it is the safe template with no real key)
.env
.env.local
.env.production
.env.development

# --- Python ------------------------------------------------------------------
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Node / frontend ---------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
*.log
npm-debug.log*

# --- ML artifacts (regenerated by `python ml/train.py`) ----------------------
ml/artifacts/

# --- Local data files (swap-in datasets, exports, etc.) ----------------------
*.csv
*.tsv
*.parquet
*.xlsx
*.h5
*.hdf5
data/
datasets/

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
